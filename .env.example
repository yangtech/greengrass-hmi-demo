# ═══ FANUC HMI Demo — Environment Configuration ═══
# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# AWS
AWS_ACCOUNT_ID=<your-aws-account-id>
AWS_REGION=us-east-1

# EC2
EC2_INSTANCE_ID=<your-instance-id>
EC2_ELASTIC_IP=<your-elastic-ip>
EC2_AMI_ID=<your-ami-id>
EC2_SECURITY_GROUP=<your-sg-id>
SSH_KEY_PATH=~/.ssh/greengrass-demo.pem

# Cognito
COGNITO_USER_POOL_ID=<your-pool-id>
COGNITO_CLIENT_ID=<your-client-id>

# Flask
FLASK_SECRET_KEY=<generate-with: python3 -c "import secrets; print(secrets.token_hex(32))">

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# S3 (batch Transcribe fallback)
TRANSCRIBE_BUCKET=<your-bucket-name>

# Lambda (batch fallback — not actively used)
TRANSCRIBE_LAMBDA_NAME=<your-lambda-name>
